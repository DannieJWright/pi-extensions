// Provider-scoped prompt rules. Read by the provider-prompt-rules extension at session start
// and by `just provider-rules check`. Unknown keys and bad values are dropped and reported.

{
  "providers": {
    "strata": {
      "sequentialSubagents": true,

      // Wording for strata. A model entry can override it; the top-level text block is the default.
      // A string, or an array of lines joined with a newline. Keep it byte-stable: a change
      // mid-session busts the prompt cache.
      "text": {
        "sequentialSubagents": [
          "This provider serves one agent at a time.",
          "- Run one subagent at a time. Do not dispatch another while one is running.",
          "- Wait for each subagent to finish before starting the next. Use acp_delegate_wait to block for its result.",
          "- While a subagent is running, do not do other work and do not call tools."
        ]
      }
    }
  },

  // Deepest defined level wins: model > provider.
  "modelOverrides": {
    "local-llama/qwen-3.6-27B-tc-262k": { "sequentialSubagents": false }
  },

  // Default wording for a rule when an entry does not set its own text.
  "text": {}
}
