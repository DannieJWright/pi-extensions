// Source: ~/.pi/agent/permissions.src.jsonc. Edit it, then run `just perm` in ~/.pi.
// Prompt references name files outside this repository; their sources are recorded in NOTICE. See the generator README for merge rules.
//
// Pattern maps (path, external_directory, write, bash, tool, ...): the LAST matching key wins,
// so "*" must come first. When a mode overrides an inherited key, the key keeps its position;
// new keys are appended at the end. Use "$replace": true to write a full map in your own order.
{
  "permissionModes": {
  "output": {
    "$schema": "https://raw.githubusercontent.com/wynainfo/pi-permission-modes/main/schemas/permission-mode.schema.json",
    "defaultMode": "default",
    "cycleOrder": ["default", "plan", "build", "plan-local", "build-local", "build-yolo", "yolo"]
  },

  "fragments": {
    // Shared by every mode, YOLO included.
    "pathGate": {
      "permission": {
        "path": {
          "*": "allow",
          "~/.pi/agent/rehydra/*": "deny",
          "~/.pi/agent/secrets-protection/*": "deny"
        }
      }
    },

    // Shared by all sandboxed modes.
    "common": {
      "extends": ["pathGate"],
      "sandbox": {
        "enabled": true,
        "writable": true,
        "allowWrite": [".", "/tmp/pi"],
        "denyWrite": [],
        "denyRead": [
          "~/.ssh",
          "~/.aws",
          "~/.gnupg",
          "~/.netrc",
          "~/.git-credentials",
          "~/.pypirc",
          "~/.gem/credentials",
          "~/.vault-token",
          "~/.password-store",
          "~/.pi/agent/auth.json",
          "~/.pi/agent/oauth.json",
          "~/.pi/agent/rehydra/records/records.sqlite",
          "~/.pi/agent/secrets-protection/records.sqlite"
        ],
        // Bash: paths under these roots are not "escapes" (no prompt, runs sandboxed, read-only).
        "insideRoots": [
          "~/.agents/skills",
          "~/.pi/agent/skills", 
          "~/.pi/agent/npm/node_modules",
          "<temp>/acp-delegate",
          "/tmp/just-tools/outputs",
          "<runtime-dir>/just",
          "~/.pi/agent/install/releases"
        ],
        "network": {
          "allowedDomains": [
            "npmjs.org",
            "*.npmjs.org",
            "registry.npmjs.org",
            "registry.yarnpkg.com",
            "pypi.org",
            "*.pypi.org",
            "github.com",
            "*.github.com",
            "api.github.com",
            "raw.githubusercontent.com"
          ],
          "deniedDomains": []
        }
      },
      "permission": {
        // File tools outside the project. Local modes override only "*".
        "external_directory": {
          "*": "ask",
          "~/.agent/skills": "allow",
          "~/.agent/skills/*": "allow",
          "~/.agents/skills/*": "allow",
          "~/.pi/agent/skills": "allow",
          "~/.pi/agent/skills/*": "allow",
          "~/.pi/agent/npm/node_modules": "allow",
          "~/.pi/agent/npm/node_modules/*": "allow",
          "/var/folders": "allow",
          "/var/folders/*": "allow",
          "/private/var/folders": "allow",
          "/private/var/folders/*": "allow",
          "<temp>/acp-delegate/*": "allow",
          "/tmp/just-tools/outputs/*": "allow",
          "~/.pi/agent/install/releases/*": "allow"
        },
        "read": "allow",
        "grep": "allow",
        "find": "allow",
        "ls": "allow",
        // Modes override only "*"; the guards after it stay in force.
        "write": {
          "*": "ask",
          "~/.pi/agent/skills/*": "ask",
          "~/.agent/skills/*": "ask",
          "~/.pi/agent/npm/node_modules/*": "deny",
          "/var/folders/*": "deny",
          "/private/var/folders/*": "deny"
        },
        "edit": {
          "*": "ask",
          "~/.pi/agent/skills/*": "ask",
          "~/.agent/skills/*": "ask",
          "~/.pi/agent/npm/node_modules/*": "deny",
          "/var/folders/*": "deny",
          "/private/var/folders/*": "deny"
        },
        "bash": {
          "*": "ask"
        },
        "web_search": "allow",
        "tool": {
          "*": "ask",
          "acp_delegate": "allow",
          "acp_delegate_wait": "allow",
          "acp_status": "allow",
          "acp_read_original_image": "allow",
          "compress": "allow",
          "decompress": "allow",
          "web_enable": "allow",
          "fetch_content": "allow",
          "get_search_content": "allow",
          "source_check": "allow",
          "search_context": "allow",
          "acp_delegate_cancel": "allow",
          "just_test": "allow",
          "git_r_*": "allow",
          // Ledger tools bypass file-tool path gates; submit also runs unsandboxed commands.
          "ledger_check": "allow",
          "ledger_list": "allow",
          "ledger_next": "allow"
          // "": "allow",
          // "": "allow",
        },
        "skill": "allow"
      }
    },

    // Local modes: deny file-tool access outside the project, except the allows in common.
    // Bash escapes still prompt (the extension cannot deny them by config).
    "local": {
      "permission": {
        "external_directory": {
          "*": "deny"
        }
      }
    }
  },

  "modes": {
    "default": {
      "extends": ["common"],
      "label": "Default",
      "color": "muted"
    },

    "plan": {
      "extends": ["common"],
      "label": "Plan Mode",
      "color": "mdLink",
      // A custom prompt avoids the @plan approval UI. show_plan still displays files.
      // Both value forms in one value: an object-form reference plus inline text. The golden fixture records this as a marker.
      "systemPrompt": {
        "files": [{ "path": "../extensions/permission-mode-generator/test-fixtures/agents/agent-with-frontmatter.md", "stripFrontmatter": true }],
        "text": "## Plan mode is active\n\nInspect the task, discuss unclear requirements, and prepare or review plans. Do not implement code in this mode. Bash is read-only; only Markdown files can be created or edited. When the user requests a plan, clarify open questions first, then write a concise plan under plan/ and use show_plan to display it. A plan can be reviewed and revised in later runs. Do not request approval through /plan approve or delete plan files unless the user asks. These planning instructions apply only while this mode is active; a switch to Build permits implementation under Build's permissions."
      },
      "sandbox": {
        "writable": false
      },
      "permission": {
        "write": {
          "$replace": true,
          "*": "deny",
          "*.md": "ask",
          "*.markdown": "ask",
          "plan/*.md": "allow",
          "*/plan/*.md": "allow",
          "plans/*.md": "allow",
          "*/plans/*.md": "allow",
          // Guards last, so a plan/ folder inside them does not get "allow".
          "~/.pi/agent/skills/*": "ask",
          "~/.agent/skills/*": "ask",
          "~/.pi/agent/npm/node_modules/*": "deny",
          "/var/folders/*": "deny",
          "/private/var/folders/*": "deny"
        },
        "edit": {
          "$replace": true,
          "*": "deny",
          "*.md": "ask",
          "*.markdown": "ask",
          "plan/*.md": "allow",
          "*/plan/*.md": "allow",
          "plans/*.md": "allow",
          "*/plans/*.md": "allow",
          // Guards last, so a plan/ folder inside them does not get "allow".
          "~/.pi/agent/skills/*": "ask",
          "~/.agent/skills/*": "ask",
          "~/.pi/agent/npm/node_modules/*": "deny",
          "/var/folders/*": "deny",
          "/private/var/folders/*": "deny"
        },
        "bash": {
          "*": "allow"
        },
        "tool": { "ledger_start": "deny", "ledger_submit": "deny" }
      }
    },

    "build": {
      "extends": ["common"],
      "label": "Build",
      "color": "accent",
      "systemPrompt": "## Build mode is active\n\nImplement the user's current request under this mode's permissions. If the user asks you to implement a plan, read the plan file and start the work; do not wait for /plan approve or a Plan-mode UI prompt. Previous Plan-mode instructions do not restrict this mode. Keep plan files for later review; delete them only if the user asks.",
      "permission": {
        "write": { "*": "allow" },
        "edit": { "*": "allow" },
        "bash": { "*": "allow" },
        "tool": { "ledger_start": "allow", "ledger_submit": "allow" }
      }
    },

    "plan-local": {
      "extends": ["plan", "local"],
      "label": "Plan (local)"
    },

    "build-local": {
      "extends": ["build", "local"],
      "label": "Build (local)"
    },

    "build-yolo": {
      "extends": ["build", "local"],
      "label": "Build (yolo)",
      "color": "error",
      "sandbox": { "enabled": false }
    },

    "yolo": {
      "extends": ["pathGate"],
      "label": "YOLO",
      "color": "error",
      "sandbox": {
        "enabled": false,
        "writable": true
      },
      "bypassProtectedPaths": true,
      "permission": {
        "external_directory": "allow",
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "grep": "allow",
        "find": "allow",
        "ls": "allow",
        "bash": { "*": "allow" },
        "web_search": "allow",
        "tool": "allow",
        "skill": "allow"
      }
    }
  }
  },
  "subagents": {
    // Optional native child permissions; omit config to leave config.json unchanged:
    // "config": { "permissions": { "rules": { "edit": "ask" } } },
    "fragments": {
      "gitTools": {
        "tools+": ["git_r_diff", "git_r_status", "git_r_log", "git_r_show"],
        "subagentOnlyExtensions+": ["~/.pi/agent/git/github.com/DannieJWright/pi-extensions/extensions/git-tools/index.ts"]
      },
      // Operator-supplied worker override: ledger_next, ledger_start, ledger_submit,
      // ledger_check and mutationTools. ledger_list is added for the sample.
      // The provider uses ~ for portability; adjust paths for your installation.
      "ledgerTools": {
        "extends": ["gitTools"],
        "tools+": ["ledger_check", "ledger_list", "ledger_next", "ledger_start", "ledger_submit"],
        "subagentOnlyExtensions+": ["~/.pi/agent/git/github.com/DannieJWright/pi-extensions/extensions/feature-ledger/index.ts"],
        "mutationTools+": ["ledger_start", "ledger_submit"]
      }
    },
    "agents": {
      "reviewer": {
        "extends": ["gitTools"],
        "tools+": ["read", "grep", "find", "ls", "watchdog_diff", "contact_supervisor"],
        // Real-world form: point at your own install, e.g.
        //   { "files": [{ "path": "~/npm/node_modules/pi-subagents/agents/reviewer.md", "stripFrontmatter": true }, { "path": "prompts/reviewer-addendum.md", "stripFrontmatter": true }] }
        // An install path is machine-specific, so adjust it; the package must be present for generation to succeed.
        // This test layer uses this repository's own fixture agent file instead of an installed package.
        "systemPrompt": {
          "files": [
            { "path": "../extensions/permission-mode-generator/test-fixtures/agents/agent-with-frontmatter.md", "stripFrontmatter": true },
            { "path": "prompts/reviewer-addendum.md", "stripFrontmatter": true }
          ]
        }
      },
      "scout": {
        "extends": ["gitTools"],
        "tools+": ["read", "grep", "find", "ls", "bash", "write", "contact_supervisor"]
      },
      // A project that routes UI items needs a "ui-worker" agent entry here with the capture_* tools allowed.
      "worker": {
        "extends": ["ledgerTools"],
        "tools+": ["read", "grep", "find", "ls", "bash", "edit", "write", "contact_supervisor"]
      }
    }
  }
}
